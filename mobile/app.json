{
  "expo": {
    "name": "ClassPulse AI",
    "slug": "classpulse-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.classpulse.ai"
    },
    "android": {
      "package": "com.classpulse.ai",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "ClassPulse AI requires camera access to detect classroom and library objects in real time.",
          "recordAudioAndroid": false
        }
      ],
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#0D1B2A"
        }
      ]
    ],
    "scheme": "classpulse",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
