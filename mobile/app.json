{
  "expo": {
    "name": "RoomPulse",
    "slug": "classpulse-ai",
    "icon": "./assets/app-icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.classpulse.ai"
    },
    "android": {
      "package": "com.classpulse.ai",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#0A2540"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "RoomPulse requires camera access to detect classroom and library objects in real time.",
          "recordAudioAndroid": false
        }
      ],
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splashs.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#030712"
        }
      ]
    ],
    "scheme": "classpulse",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "5b83bbeb-d38a-433e-b0f9-e49e315edb7e"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
