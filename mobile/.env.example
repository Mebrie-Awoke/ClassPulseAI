# ===========================================================================
# ClassPulse AI — Mobile Environment Variables
# ===========================================================================

# Set to your FastAPI backend address:
# - For physical Android device testing on local Wi-Fi:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.XXX:8000
#
# - For Android emulator on the same PC:
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
#
# - For Production / Render deployment:
#   EXPO_PUBLIC_API_BASE_URL=https://classpulse-ai-backend.onrender.com

EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
